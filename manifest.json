{
  "manifest_version": 3,
  "name": "PhishGuard - Hybrid Phishing Scanner",
  "version": "1.2.0",
  "description": "A private, local phishing scanner using URL, heuristic, and webpage structure analysis.",
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Scan this page with PhishGuard",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.svg",
      "48": "icons/icon48.svg",
      "128": "icons/icon128.svg"
    }
  },
  "icons": {
    "16": "icons/icon16.svg",
    "48": "icons/icon48.svg",
    "128": "icons/icon128.svg"
  },
  "permissions": [
    "tabs",
    "scripting",
    "webNavigation",
    "storage",
    "clipboardWrite"
  ],
  "host_permissions": ["http://*/*", "https://*/*"]
}
